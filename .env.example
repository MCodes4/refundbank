# Solana
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_NETWORK=devnet
# mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Your pump.fun token
TOKEN_MINT_ADDRESS=REPLACE_WITH_YOUR_TOKEN_MINT_ADDRESS

# Helius — get at helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# Supabase — get at app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Creator wallet — NEVER commit this. Store in Supabase Vault in production.
# In Supabase edge functions, set this as a secret: supabase secrets set CREATOR_WALLET_PRIVATE_KEY=...
CREATOR_WALLET_PRIVATE_KEY=your_base58_encoded_private_key_here

# Optional thresholds (also managed via config table in DB)
MIN_HOLDER_VALUE_SOL=0.05
MIN_HOLDER_INVESTED_SOL=0.1
MAX_SINGLE_PAYOUT_PCT=0.05
